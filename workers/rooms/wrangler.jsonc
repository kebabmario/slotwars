{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "slotwars-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // no public *.workers.dev URL: only the Pages Functions reach these objects, through bindings
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "AUTH", "class_name": "AuthGate" },
      { "name": "ROOM", "class_name": "MatchRoom" }
    ]
  },
  // Free plan: SQLite-backed Durable Objects only
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AuthGate"] },
    { "tag": "v2", "new_sqlite_classes": ["MatchRoom"] }
  ],
  // finished matches are written here once
  "d1_databases": [
    { "binding": "DB", "database_name": "slotwars-db", "database_id": "dd2fe3f4-db3a-44c4-beab-419e41c72f6d", "migrations_dir": "../../migrations" }
  ]
  // secret PEPPER: set with `wrangler secret put PEPPER --config workers/rooms/wrangler.jsonc`
  // optional vars GRACE_MS / ABANDON_MS override 120 s / 10 min (tests use short values)
}
